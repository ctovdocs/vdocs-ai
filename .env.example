VITE_DATA_MODE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI patient assistant (client): point at the dev-server proxy below. Leave blank to disable the feature.
VITE_AI_PROXY_URL=/api/patient-ai

# AI patient assistant (server-only — never prefix these with VITE_, never commit real values).
# Pick one provider and set its matching key; the app reads these in vite.config.ts, not in the browser.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice dictation (server-only). Powers the mic button on every free-text field a doctor fills in.
# Get a key at https://www.assemblyai.com — sync API, short-clip dictation.
ASSEMBLYAI_API_KEY=
# Optional override; defaults to gemini-2.5-flash using GEMINI_API_KEY above.
VOICE_CLEANUP_MODEL=
